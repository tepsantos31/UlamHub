EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for release/production builds (preview & production eas.json profiles) —
# without it the app falls back to a LAN-IP guess that only works in local dev.
# Point this at the deployed backend, e.g. https://ulam-backend.onrender.com
EXPO_PUBLIC_API_BASE_URL=https://your-deployed-backend.example.com

# From the RevenueCat dashboard (Project settings -> API keys), after you've
# configured monthly/annual products there and linked them to App Store
# Connect / Play Console. Without these the paywall falls back to a local
# mock subscription (no real purchase) — see lib/purchases.ts.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-ios-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-android-key
